# =============================================================================
# Zerodha CNC Dip-Buying & Stop-Loss Copilot Configuration (.env)
# =============================================================================

# --- Core Safety & Brokerage ---
# DRY_RUN: Keep true by default. When true, GTT orders are validated and simulated without live submission.
DRY_RUN=true

# Kite MCP Server endpoint (default: official streamable HTTP endpoint)
KITE_MCP_URL=https://mcp.kite.trade/mcp

# Zerodha DDPI / Demat Debit and Pledge Instruction status
# If false, triggered Stage-2 Sell OCO GTT orders will fail without manual daily CDSL TPIN authorization.
ZERODHA_DDPI_ENABLED=false

# --- Storage & Audit ---
DB_PATH=data/copilot.db
AUDIT_LOG_PATH=data/trade_audit.jsonl

# --- RiskGuard Parameters ---
# Maximum worst-case loss per trade as a fraction of portfolio value (default 0.01 = 1%)
MAX_RISK_PER_TRADE_PCT=0.01

# Maximum capital allocated to any single stock position (default 0.10 = 10%)
MAX_POSITION_SIZE_PCT=0.10

# Maximum portfolio exposure per sector (default 0.25 = 25%)
MAX_SECTOR_SIZE_PCT=0.25

# Duplicate order suppression window in seconds
DUPLICATE_ORDER_WINDOW_SEC=30

# --- LLM Provider Configuration ---
# Provider: "ollama" (default local) or "claude"
LLM_PROVIDER=ollama

# Ollama settings (when using ollama provider)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Claude settings (when using claude provider)
ANTHROPIC_API_KEY=sk-ant-xxx
CLAUDE_MODEL=claude-sonnet-4-20250514

# --- Scheduler & Alerting ---
SCHEDULE_TIMEZONE=Asia/Kolkata
# Optional Webhook alerts for post-CAS fills, gap-down SL triggers, and weekly digests
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Observability (optional) ---
# LangSmith tracing for LangGraph workflows
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=portfolio-copilot
